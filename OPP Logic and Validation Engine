class CalculadoraFinanciera:
    def __init__(self):
        self.historial = []

    def agregar_transaccion(self,transaccion: Transaccion):
        if not isinstance(transaccion, Transaccion):
            raise TypeError("Solo se pueden agregar objetos de la clase transaccion")
        self.historial.append(transaccion)
        print(f"La transaccion fue agregada con exito: {transaccion.concepto}")

## Comento la clase anterior junto a sus metodos privados ( funciones ):
# Creamos la clase financiera, y creamos una lista en esa clase.
#  despues creamos otro metodo con el nombre agregar transaccion, a la cual uno de los parametros se lo asociamos a la clase principal (TRANSACCION)
# despues si no esta en transaccion que me genere un error de tipo de dato, en el cual me diga que solo se puedan agregar objetos de la clase transaccion
# despues con self.historial la lista que teniamos anterior mente, le agregamos los datos de transaccion

#Recordar: _funcion_cualquiera, es un metodo privado al cual solo queremos acceder en esta clase
# funcion_cualqueira, es un metodo publico que permite agregar o operar con nuestra clase desde el exterior por asi decirlo.

    def calcular_balance(self) -> float:
     balance = 0.0
     for t in self.historial:
        if t.tipo == 'ingreso':
            balance += t.monto
        elif t.tipo == 'gasto':
            balance -= t.monto
     return balance

#Comentario de la seccion anterior del metodo publico
# creamos una variable la cual esta en cero
# creamos un loop for para cada elemento en nuestra lista historial
# que funcione con la condicional de que si cada tipo de e elemento es ingreso o gasto, sume o reste. el monto.

    def resumen_por_categoria(self, tipo : str = 'gasto') -> dict:
     resumen = {}
     for t in self.historial:
        if t.tipo == tipo:
            resumen[t.categoria] = resumen.get(t.categoria, 0.0) + t.monto
            return resumen

## Comentario de la parte anterior 
